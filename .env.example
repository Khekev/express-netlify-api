# ==========================================================
# Plantilla de variables de entorno (NO poner valores reales)
# Copia este archivo como .env para desarrollo local.
# En producción, configúralas en Netlify > Site configuration
# > Environment variables.
# ==========================================================

# Clave para proteger el endpoint POST /api/send-email
# (usa una cadena larga y aleatoria)
API_SECRET_KEY=

# Configuración SMTP para enviar correos (solo /api/send-email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# NOTA: Netlify Blobs NO necesita token ni Site ID.
# - En local, "netlify dev" usa un emulador.
# - En producción, el SDK detecta las credenciales automáticamente.
# Solo define NETLIFY_SITE_ID y NETLIFY_AUTH_TOKEN si necesitas
# apuntar al almacén real desde tu computadora (y nunca en el repo).