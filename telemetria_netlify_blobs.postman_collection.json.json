{
  "info": {
    "name": "Telemetría Netlify Blobs",
    "description": "Pruebas de la API de telemetría del funnel con Express y Netlify Blobs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://express-netlify-api1.netlify.app"
    },
    {
      "key": "apiKey",
      "value": "TU_API_KEY"
    }
  ],
  "item": [
    {
      "name": "Consultar hora",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/time"
      }
    },
    {
      "name": "POST - Evento de atracción (tofu_attraction)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve el evento con id', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('success');",
              "  pm.expect(json.data.id).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"step\": \"tofu_attraction\",\n  \"source\": \"qr_campus\",\n  \"sessionId\": \"usuario_001\",\n  \"metadata\": {\n    \"device\": \"mobile\",\n    \"utm_source\": \"qr_campus\"\n  }\n}"
        },
        "url": "{{baseUrl}}/api/metrics"
      }
    },
    {
      "name": "POST - Evento de conversión (bofu_interaction)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('El paso es bofu_interaction', () => {",
              "  pm.expect(pm.response.json().data.step).to.eql('bofu_interaction');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"step\": \"bofu_interaction\",\n  \"source\": \"qr_campus\",\n  \"sessionId\": \"usuario_001\",\n  \"metadata\": {\n    \"device\": \"mobile\",\n    \"projectTarget\": \"alianza-juego-companeros\"\n  }\n}"
        },
        "url": "{{baseUrl}}/api/metrics"
      }
    },
    {
      "name": "POST - Error: falta source (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"step\": \"tofu_attraction\"\n}"
        },
        "url": "{{baseUrl}}/api/metrics"
      }
    },
    {
      "name": "POST - Error: campos vacíos (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"step\": \"   \",\n  \"source\": \"qr_campus\"\n}"
        },
        "url": "{{baseUrl}}/api/metrics"
      }
    },
    {
      "name": "GET - Consultar resumen y eventos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Incluye resumen agregado', () => {",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.summary.totalEvents).to.be.a('number');",
              "  pm.expect(data.summary).to.have.property('byStep');",
              "  pm.expect(data.summary).to.have.property('bySource');",
              "  pm.expect(data.recentEvents).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/metrics"
      }
    },
    {
      "name": "GET - Filtrar por paso",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Todos los eventos son tofu_attraction', () => {",
              "  const eventos = pm.response.json().data.recentEvents;",
              "  eventos.forEach(e => pm.expect(e.step).to.eql('tofu_attraction'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/metrics?step=tofu_attraction"
      }
    },
    {
      "name": "GET - Filtrar por fuente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Todos los eventos son qr_campus', () => {",
              "  const eventos = pm.response.json().data.recentEvents;",
              "  eventos.forEach(e => pm.expect(e.source).to.eql('qr_campus'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/metrics?source=qr_campus"
      }
    },
    {
      "name": "GET - Exportar CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type es text/csv', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
              "});",
              "pm.test('Content-Disposition es attachment', () => {",
              "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/metrics/export?format=csv"
      }
    },
    {
      "name": "POST - Enviar correo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"edomex10@amerike.edu.mx\",\n  \"subject\": \"Prueba de API\",\n  \"message\": \"Este es un correo de prueba.\",\n  \"senderName\": \"Mi API\"\n}"
        },
        "url": "{{baseUrl}}/api/send-email"
      }
    }
  ]
}